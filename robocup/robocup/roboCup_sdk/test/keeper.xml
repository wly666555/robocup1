<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <ReactiveSequence name="root_sequence">
      <camTrackBall  name="camTrackBall"/>
      <GoalieDecision decision="{decision}" />
      <Fallback>
        <Sequence>
          <CheckDecision expected="robotTrackPelvis" actual="{decision}" />
          <robotTrackPelvis />
        </Sequence>
        <Sequence>
          <CheckDecision expected="GoalieKickBall" actual="{decision}" />
          <GoalieKickBall />
        </Sequence>
        <Sequence>
          <CheckDecision expected="GoalieBackToHome" actual="{decision}" />
          <GoalieBackToHome />
        </Sequence>
        <Sequence>
          <CheckDecision expected="GoalieFindBall" actual="{decision}" />
          <GoalieFindBall />
        </Sequence>
      </Fallback>
    </ReactiveSequence>
  </BehaviorTree>
</root>
