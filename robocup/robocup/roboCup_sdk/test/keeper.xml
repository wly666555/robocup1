<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="root">
          <ReactiveSequence _while="!odom_calibrated"  name="locate">
              <CamFindBall />
              <SubTree ID="CamFindAndTrackBall" _autoremap="true" _while="odom_calibrated" />
          </ReactiveSequence>

          <ReactiveSequence _while="player_role=='striker" name="/定位成功">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <Sequence>
                  <GoalieDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="1.2" />
                  <Sequence _while ="decision == 'find'">
                    <RobotFindBall _while ="ball_range <= 3.0" />
                    <MoveToPoseOnField _while ="ball_range > 3.0" long_range_threshold="100.0" x="-6.0" />
                  </Sequence>

                  <MoveToPoseOnField _while ="decision == 'gohome" long_range_threshold="100.0" x="-6.0" />
                  <Chase   _while="decision == 'chase'"   dist="1.0"/>
                  <Adjust  _while="decision == 'adjust'"  />
                  <Sequence  _while="decision == 'kick'">
                     <SetVelocity />
                     <Sleep msec="1000" />
                     <Kick />
                  </Sequence>
            </Sequence>
         </ReactiveSequence>
          
        </Sequence>
  </BehaviorTree>
</root>
