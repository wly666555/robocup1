<?xml version="1.0"?>
<package format="3">
  <name>football_detect</name>
  <version>0.1.0</version>
  <description>Football detection with YOLO, TensorRT, RealSense, DDS, and ROS2</description>
  <maintainer email="your@email.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2依赖 -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>robot_interfaces</depend> <!-- 依赖消息包 -->

  <!-- 其他依赖 -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-onnxruntime</exec_depend>
  <exec_depend>librealsense2</exec_depend>
  <exec_depend>opencv</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
